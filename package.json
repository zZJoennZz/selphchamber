{
  "name": "selph-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build tooling for the Selph Theme (WordPress block theme).",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "clean": "node -e \"require('fs').rmSync('assets/css',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
